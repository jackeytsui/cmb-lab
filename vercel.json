{
  "framework": "nextjs",
  "buildCommand": "node scripts/apply-migrations.mjs && npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/ghl-webhooks",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/ghl-inactive",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ghl-course-progress",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/post-purchase-entitlements",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/coaching-reminders",
      "schedule": "* * * * *"
    }
  ]
}
